# Supabase project (Project Settings > API Keys) — the main datastore.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Only needed for the remote MCP connector (claude.ai custom connector) ---
# Pooled Postgres connection string (Supabase > Connect > Transaction pooler), for
# Better Auth's own tables (users/sessions/oauth clients). Use the pooler, not the
# direct connection — the direct host is unreliable from serverless environments.
DATABASE_URL=
# Random secret, e.g. `openssl rand -hex 32`. Local and production share one database,
# so they must use the SAME value: the JWKS private key is encrypted with it.
BETTER_AUTH_SECRET=
# This app's own public URL (http://localhost:3000 locally; the deployed URL in prod)
BETTER_AUTH_URL=
# Only this email may sign in / register the MCP OAuth client — locks the connector
# to a single owner account since email/password sign-up is otherwise open.
OWNER_EMAIL=

# Free key from https://aistudio.google.com/apikey — powers the AI chat editor
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
