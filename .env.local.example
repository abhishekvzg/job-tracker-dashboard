# Supabase project (Project Settings > API Keys) — the main datastore.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Only needed for the remote MCP connector (claude.ai custom connector) ---
# Direct Postgres connection string (Supabase > Connect > URI), for Better Auth's
# own tables (users/sessions/oauth clients) — separate from SUPABASE_URL above.
DATABASE_URL=
# Random secret, e.g. `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# This app's own public URL (http://localhost:3000 locally; the deployed URL in prod)
BETTER_AUTH_URL=
# Only this email may sign in / register the MCP OAuth client — locks the connector
# to a single owner account since email/password sign-up is otherwise open.
OWNER_EMAIL=

# Free key from https://aistudio.google.com/apikey — powers the AI chat editor
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Only needed for the optional "Export to Google Sheets" button ---
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1

# --- Only needed when deploying (e.g. to Vercel) instead of using credentials.json locally,
# and only relevant if you're using the Google Sheets export ---
# From the same OAuth client as credentials.json (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on that OAuth client, e.g.
# https://your-app.vercel.app/api/auth/callback/google
GOOGLE_REDIRECT_URI=

# Auto-populated by Vercel when you attach a KV/Redis store (Storage tab) to the project.
# Used to persist the Google OAuth token instead of writing to token.json on disk.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
